# ==============================================================================
# RepoMind Monorepo - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
PROJECT_NAME="RepoMind Backend"
ENVIRONMENT="development"
DEBUG=true
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Repository Ingestion & Storage Limits
REPO_STORAGE_PATH="data/repositories"
MAX_REPO_SIZE_MB=500
MAX_REPO_FILE_COUNT=50000
GIT_CLONE_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / SQLAlchemy)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=repomind_user
POSTGRES_PASSWORD=repomind_password
POSTGRES_DB=repomind_db
DATABASE_URL=postgresql://repomind_user:repomind_password@localhost:5432/repomind_db

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:8000"
VITE_APP_TITLE="RepoMind - AI Codebase Intelligence"

# ------------------------------------------------------------------------------
# Worker Configuration (Python Background Worker)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=5
WORKER_LOG_LEVEL="INFO"
